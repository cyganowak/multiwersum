{
    "app-id": "com.github.cyganowak.multiwersum",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.8",
    "sdk": "org.kde.Sdk",
    "command": "multiwersum",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-config/omarchy:ro"
    ],
    "cleanup": [ "/include", "/lib/pkgconfig", "/share/man" ],
    "modules": [
        {
            "name": "multiwersum",
            "buildsystem": "simple",
            "build-commands": [
                "qmake6 PREFIX=/app",
                "make",
                "make install"
            ],
            "sources": [
                { "type": "dir", "path": ".." }
            ]
        },
        {
            "name": "data",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 multiwersum.desktop %{FLATPAK_DEST}/share/applications/com.github.cyganowak.multiwersum.desktop",
                "install -Dm644 com.github.cyganowak.multiwersum.svg %{FLATPAK_DEST}/share/icons/hicolor/scalable/apps/com.github.cyganowak.multiwersum.svg"
            ],
            "sources": [
                { "type": "file", "path": "com.github.cyganowak.multiwersum.desktop", "dest-filename": "multiwersum.desktop" },
                { "type": "file", "path": "com.github.cyganowak.multiwersum.svg", "dest-filename": "com.github.cyganowak.multiwersum.svg" }
            ]
        }
    ]
}
